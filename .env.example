# Required browser-safe Supabase configuration.
# Use your own project values; never put a service-role/secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Reserved for a future public app URL; the frontend does not currently read it.
VITE_APP_URL=http://localhost:5173
